{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist-electron",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["apps/desktop/electron/**/*.ts", "packages/core/src/**/*.ts", "packages/desktop-services/src/**/*.d.ts", "packages/vocabulary/parse.mjs"]
}
