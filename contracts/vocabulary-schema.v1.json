{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/vocabulary-schema.v1.json",
  "title": "Neutral local wording overlay schema",
  "description": "A bounded, local-only mapping supplied by the person using the application.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "entries": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^(?!__proto__$)(?!prototype$)(?!constructor$)[^\\u0000-\\u001f\\u007f]+$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 1000,
        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
      }
    }
  }
}
